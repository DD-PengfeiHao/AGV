# Fast path: reuse v0.1 image, rebuild v0.2 sources (no Gazebo apt).
# Full Gazebo: use docker/Dockerfile when mirrors work.
# NOTE: no dockerfile syntax directive — avoids docker.io pull in offline CN nets.
FROM delivery-ros2:humble-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    DELIVERY_WS=/opt/delivery_ws \
    LIBGL_ALWAYS_SOFTWARE=1 \
    ROS_DISTRO=humble \
    PYLON_ROOT=/opt/pylon \
    GENICAM_GENTL64_PATH=/opt/pylon/lib/gentlproducer/gtl

# Optional extras for v0.2 (mirrors); ignore failure if offline
RUN set -eux; \
    sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list || true; \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list || true; \
    apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-trajectory-msgs \
      ros-humble-tf2-ros \
      ros-humble-tf2-py \
      python3-pil \
      curl \
      iproute2 \
      iputils-ping \
    && rm -rf /var/lib/apt/lists/* || true

# Jason Basler camera + QR build/runtime dependencies
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-cv-bridge \
      ros-humble-image-transport \
      ros-humble-pcl-ros \
      ros-humble-camera-info-manager \
      ros-humble-image-geometry \
      ros-humble-diagnostic-updater \
      python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# Pylon SDK 8.0.0 — REQUIRED for Jason Camera Smoke Test (see docker/vendor/pylon/README.md)
COPY docker/vendor/pylon/ /tmp/pylon_vendor/
RUN set -eux; \
    PYLON_DEBS="$(find /tmp/pylon_vendor -maxdepth 1 -type f -name 'pylon-8.0.0*debs*.tar.gz' | head -1)"; \
    PYLON_SETUP="$(find /tmp/pylon_vendor -maxdepth 1 -type f -name 'pylon-8.0.0*setup*.tar.gz' | head -1)"; \
    if [ -n "$PYLON_DEBS" ]; then \
      echo "Installing Pylon from debs archive: $PYLON_DEBS"; \
      mkdir -p /tmp/pylon/extract && cd /tmp/pylon/extract && \
      tar -xzf "$PYLON_DEBS" && \
      dpkg -i pylon_*.deb || apt-get install -yf; \
    elif [ -n "$PYLON_SETUP" ]; then \
      echo "Installing Pylon from setup archive: $PYLON_SETUP"; \
      mkdir -p /tmp/pylon/setup && tar -xzf "$PYLON_SETUP" -C /tmp/pylon/setup; \
      INNER="$(find /tmp/pylon/setup -maxdepth 1 -type f -name 'pylon-*.tar.gz' ! -name '*setup*' | head -1)"; \
      test -n "$INNER"; \
      mkdir -p /opt/pylon && tar -xzf "$INNER" -C /opt/pylon; \
      chmod 755 /opt/pylon; \
    else \
      echo "ERROR: Missing official Pylon 8.0.0 package in docker/vendor/pylon/"; \
      echo "Expected: pylon-8.0.0*debs*.tar.gz OR pylon-8.0.0*setup*.tar.gz (keep original filename)"; \
      ls -la /tmp/pylon_vendor/; \
      exit 1; \
    fi; \
    rm -rf /tmp/pylon /tmp/pylon_vendor; \
    test -f /opt/pylon/lib/libpylonbase.so.9 || test -f /opt/pylon/lib64/libpylon.so; \
    test -f /opt/pylon/share/pylon/cmake/pylon-config.cmake; \
    echo "PYLON_INSTALLED=1" > /etc/agv_pylon_state

WORKDIR ${DELIVERY_WS}
RUN rm -rf ${DELIVERY_WS}/src ${DELIVERY_WS}/build ${DELIVERY_WS}/install ${DELIVERY_WS}/log || true
COPY ros2_ws/src ${DELIVERY_WS}/src
COPY config/stations_from_smap.json /data/agv_downloaded/maps/stations_from_smap.json

SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build --symlink-install

COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/boot_gazebo.sh /boot_gazebo.sh
COPY docker/boot_gazebo_lite.sh /boot_gazebo_lite.sh
COPY docker/boot_jason_camera.sh /boot_jason_camera.sh
RUN chmod +x /entrypoint.sh /boot_gazebo.sh /boot_gazebo_lite.sh /boot_jason_camera.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash", "/boot_gazebo_lite.sh"]
